# ── LLM Configuration ──
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# LLM_FALLBACK_MODEL=

# ── Embedding Configuration ──
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=1536

# ── Qdrant (optional; defaults to SQLite vector store) ──
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=rag_chunks

# ── SQLite (RAG Agent internal database) ──
DATABASE_URL=sqlite+aiosqlite:///./data/rag_agent.db

# ── RPA Target Database ──
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_POOL_SIZE=5
DB_SQLITE_PATH=./data/rpa.db

# ── Storage ──
UPLOAD_DIR=./data/uploads

# ── Agent ──
MAX_LOOP_ITERATIONS=10
MAX_TOOL_RETRIES=3
MAX_TOTAL_TIME=120

# ── Reranker ──
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=16
# HF_ENDPOINT=https://hf-mirror.com

# ── Web Search ──
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5

# ── OCR ──
OCR_ENABLED=true

# ── Memory ──
MEMORY_ENABLED=true

# ── Auth ──
# Authentication is disabled in development unless API_KEY and a persistent
# SECRET_KEY are configured. Production always requires both.
# API_KEY=your-api-key-here
# Defaults to production. Set development explicitly for local dev mode.
# APP_ENV=development
# SaaS/多租户生产环境必须启用；启用后全局 API Key 将被拒绝。
MULTI_TENANT_ENABLED=false
DEFAULT_TENANT_ID=default
# FOUR_EYES_AFFECTED_ROWS=1000
# FOUR_EYES_ENABLED=true
# FOUR_EYES_OPERATION_TYPES=DELETE
# REVIEW_WHERE_REQUIRED=true
# CONTEXT_BUDGET_RATIO=0.8
# MAX_TOOL_RESULT_CHARS=2000
# MASKING_EXCLUDE_COLUMNS=id,quantity,amount,count,stock

# Required to bootstrap the first administrator when auth is enabled:
# SQL_RPA_ADMIN_USERNAME=admin
# SQL_RPA_ADMIN_PASSWORD=change-this-strong-password

# ── Server ──
# Set a persistent key for production. In development, leaving this unset
# disables authenticated multi-user mode.
# SQL_RPA_SECRET_KEY=your-secret-key-here
# Active encryption key version. During rotation, retain old keys until all
# ciphertext has been progressively re-encrypted.
ENCRYPTION_KEY_VERSION=1
# Example: {"1":"old-secret","2":"new-secret"}
ENCRYPTION_KEYS_JSON=
# Shared rate-limit state for multi-instance production deployments.
REDIS_URL=
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=30
# USD per one million tokens, merged with built-in defaults.
MODEL_PRICES_JSON={}
SLOW_QUERY_MS=500
REVIEW_EXPIRY_HOURS=24
# Enables the frozen user/membership V1 contract. Deployment-owned; never override in browser storage.
VITE_USER_MANAGEMENT_V1=true
